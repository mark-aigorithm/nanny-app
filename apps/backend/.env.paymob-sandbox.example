# Paymob TEST-mode values for `start:test:paymob-sandbox` (PAYMOB_MODE=sandbox).
#
# Copy to .env.paymob-sandbox.local, which is gitignored, and fill it in from the
# Paymob dashboard with the TEST toggle on. Never put a live key here. The
# loader refuses one (test/paymob-sandbox-guard.ts), but don't rely on that.
#
# Everything else (database, Firebase emulators, Mailpit) comes from .env.test,
# so the sandbox run shares the fake run's seeded lab.

# Settings → Account info, test mode. Start with egy_sk_test_ / egy_pk_test_.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Settings → Account info → HMAC. The webhook verifier checks every callback with it.
PAYMOB_HMAC_SECRET=
# Developers → Payment integrations: the TEST-mode online card integration id.
PAYMOB_PAYMENT_METHOD_IDS=

# Optional. Leave empty to use the tunnel URL that `pnpm paymob:tunnel` writes.
# It changes every time the tunnel restarts, and the backend reads it at start-up.
PUBLIC_API_URL=
