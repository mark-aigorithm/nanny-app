# Environment for the automated test suites. Committed on purpose: every value
# here points at a local emulator, fake or throwaway container, so there is
# nothing secret to leak. Never put a real credential in this file.
#
# Loaded by test/env.ts, which runs before any module reads `config`. dotenv
# does not overwrite variables that are already set, so these win over
# apps/backend/.env — that is what keeps a test run off the dev database.

NODE_ENV=test

# Distinct from the dev server's 3000 so a running `pnpm dev` doesn't collide
# with a suite that binds a port.
PORT=3001

# docker-compose.test.yml → postgres-test. Port 55432, not 5432: the dev
# database on 5432 must stay untouched, because tests truncate every table.
DATABASE_URL=postgresql://postgres:password@localhost:55432/nannyapp_test

# ── Firebase ───────────────────────────────────────────────────────────────
# The `demo-` prefix marks an emulator-only project; the Firebase tooling
# refuses to contact production for such an id, so a misconfigured test cannot
# reach the real nanny-now-d8518 project. This must match .firebaserc and the
# --project flag the emulator starts with, since firebase-admin rejects tokens
# whose project id differs from its own.
FIREBASE_PROJECT_ID=demo-nannyapp
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Placeholders. config.ts requires these keys to be present and well-formed,
# but lib/firebase.ts skips `credential.cert()` entirely when the emulator host
# above is set, so the private key is never parsed.
FIREBASE_CLIENT_EMAIL=test@demo-nannyapp.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=emulator-does-not-use-this-key
FIREBASE_STORAGE_BUCKET=demo-nannyapp.appspot.com

# ── Paymob ─────────────────────────────────────────────────────────────────
# Points at test/fakes/paymob-server.ts. All five variables must be set or
# buildPaymobConfig() reports the feature disabled and the payment routes
# short-circuit before the code under test is reached.
PAYMOB_API_BASE_URL=http://127.0.0.1:4010
PAYMOB_SECRET_KEY=test_secret_key
PAYMOB_PUBLIC_KEY=test_public_key
# The fake signs its webhooks with this, so parse-webhook.ts verifies a genuine
# HMAC over a genuine payload rather than a stubbed-out signature check.
PAYMOB_HMAC_SECRET=test_hmac_secret
PAYMOB_PAYMENT_METHOD_IDS=1234567
PUBLIC_API_URL=http://127.0.0.1:3001

# ── Email ──────────────────────────────────────────────────────────────────
# docker-compose.test.yml → mailpit. Accepts any credentials; tests read what
# was delivered from its HTTP API on :8025 instead of mocking nodemailer.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD=test
EMAIL_FROM=NannyApp Test <no-reply@test.local>
