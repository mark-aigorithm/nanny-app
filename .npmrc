shamefully-hoist=true

# Windows: the NDK's bundled ninja is not long-path aware, so a React Native
# native build fails on any path past 260 characters -- reported, unhelpfully, as
# "manifest 'build.ninja' still dirty after 100 tries". RN codegen writes deep
# paths (.../codegen/jni/react/renderer/components/...) beneath these directory
# names, and the default 120-character cap leaves the longest of them at 281.
# Capping the name at 20 takes that to ~241.
virtual-store-dir-max-length=20
