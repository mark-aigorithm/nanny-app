{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // No outputs: coverage is produced by `test:coverage`, not here. Declaring
    // `coverage/**` made Turborepo warn on every run about files that were
    // never going to exist.
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // Never cached: the result depends on external services (the test database
    // and the Auth emulator) that Turborepo cannot see, so a cache hit would
    // report success for a stack that may not even be running.
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
